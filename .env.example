APP_NAME="WiFi Voucher Billing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wifi_billing
DB_USERNAME=root
DB_PASSWORD=

# FreeRADIUS database connection. Leave commented to use the same database
# and credentials as above (shared-schema mode). Uncomment + fill in to
# point radcheck/radreply/radacct at a separate "radius" database instead.
# RADIUS_DB_HOST=127.0.0.1
# RADIUS_DB_PORT=3306
# RADIUS_DB_DATABASE=radius
# RADIUS_DB_USERNAME=radius
# RADIUS_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Recipient for the scheduled daily revenue report (reports:daily-revenue).
ADMIN_REPORT_EMAIL=

# Which payment gateway driver to use: selcom, clickpesa, or azampay
PAYMENT_GATEWAY=selcom

SELCOM_VENDOR_ID=
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_BASE_URL=https://apigw.selcommobile.com
SELCOM_CALLBACK_SECRET=

CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
CLICKPESA_BASE_URL=https://api.clickpesa.com
CLICKPESA_WEBHOOK_SECRET=

AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_APP_NAME=
AZAMPAY_BASE_URL=https://authenticator-sandbox.azampay.co.tz
AZAMPAY_CHECKOUT_URL=https://sandbox.azampay.co.tz
AZAMPAY_WEBHOOK_SECRET=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
